#!/bin/sh
# Managed by Ansible (security_reporting)
host="$(hostname)"
{
  echo "Security posture report — ${host} — $(date)"
  echo; echo "== Listening sockets (ss -ntulp) =="; ss -ntulp 2>/dev/null
  echo; echo "== nftables ruleset =="; nft list ruleset 2>/dev/null
  echo; echo "== fail2ban =="; fail2ban-client status 2>/dev/null
  echo; echo "== CrowdSec decisions =="; cscli decisions list 2>/dev/null
  echo; echo "== CrowdSec metrics =="; cscli metrics 2>/dev/null | head -n 40
  # SUSE has no `zypper history` subcommand; the transaction log is /var/log/zypp/history
  echo; echo "== Recent zypper history =="; tail -n 20 /var/log/zypp/history 2>/dev/null
} | mail -s "[${host}] security posture $(date +%F)" root
